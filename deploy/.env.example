# ==========================================================================
# 灵动 API · 部署配置（唯一入口）
#
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
#   docker compose -f deploy/docker-compose.yml up -d
#
# 本文件只放「这台机器」的部署配置：模式、依赖地址、密钥、代理、时区。
# 运营配置（站点地址、存储渠道、价格、支付渠道、注册策略）在管理台里改，
# 存数据库、全节点共享 —— 不要写在这里（写在这里会有两份真相源）。
#
# 【最短可用 = 下面 4 行】。其余留空/注释即为默认值。
# 少填任何一项，compose 会直接报错退出（不是"用了默认值"）。
# ==========================================================================

# ---------- 1. 必填（4 项，缺一不可）--------------------------------------
# prod / dev / test。生产必须显式写 prod：缺省会拒绝启动
#（dev 只对弱密钥告警、不拒绝）。
APP_ENV=prod

# PostgreSQL 口令 —— **这是数据库口令的唯一来源**。
# compose 用它初始化 PG，并据此拼出 backend 的 DATABASE_URL（见第 2 段）。
# 生成：openssl rand -hex 16
# 只允许 [A-Za-z0-9_-]：口令里出现 @ : / ? # 会把 DSN 拼坏（preflight 会拦下并提示）。
POSTGRES_PASSWORD=

# Redis 口令。Redis 不配口令时任何能连 6379 的进程都能改限流键与 leader 锁，
# 所以这里必填（应用本身允许空口令，是编排层替它做的决定）。
# 生成：openssl rand -hex 16
REDIS_PASSWORD=

# 库内所有密文的主密钥（渠道密钥 / 托管密钥 / API KEY 明文查看 / 2FA 密钥）。
# 生成：openssl rand -hex 32（得到 64 个字符，服务端统一 SHA-256 派生，长度不必是 16/24/32）。
# 但**至少 16 位**，否则生产拒绝启动（门槛只防"没有熵"）。**所有节点必须同一个值**，
# 换了就解不开已有密文；它不在数据库里，所以备份必须单独保管它（见 docs/deployment/backup-restore.md）。
APP_ENCRYPTION_KEY=

# ---------- 2. 数据库地址（默认派生，通常不用改）--------------------------
# 不填时由 POSTGRES_PASSWORD 自动派生：
#   postgres://lingdong:<POSTGRES_PASSWORD>@postgres:5432/lingdong?sslmode=disable
# 只有当数据库不在本编排里（云数据库 / 独立实例 / 多节点共用主库）才取消注释并改成真地址。
# 多节点部署时所有节点必须指向同一个主库。
# DATABASE_URL=postgres://lingdong:CHANGE_ME@postgres:5432/lingdong?sslmode=disable

# ---------- 3. 只用 compose 自带 PostgreSQL 时才需要 ----------------------
# 库名/用户名有默认值，改口令请改第 1 段的 POSTGRES_PASSWORD。
# POSTGRES_USER=lingdong
# POSTGRES_DB=lingdong
#
# 以下三项由编排/默认值给出，一般不用改：
# LISTEN_ADDR=:8080
# REDIS_DB=0
# STORAGE_DIR=/app/data
# Redis 地址：compose 内默认 redis:6379；用外部实例时改成它的地址（多节点必须同一实例）。
# REDIS_ADDR=redis:6379

# ---------- 4. 这台机器是什么（不写 = 单机完整模式）------------------------
# full：门户 + API。api：只有 API，访问域名根直接 404（不提供任何前端）。
# LD_NODE_MODE=full
#
# 1 = 这台机器与别的机器共用一个数据库（多节点必须开；此时存储必须是云存储）。
# 0 = 单机（默认，允许本地磁盘存储）。
# LD_CLUSTER_MODE=0

# ---------- 5. 网络与代理 ------------------------------------------------
# 业务日界，影响「今日用量 / 今日上传次数」。多节点必须一致。
# LD_TZ=Asia/Shanghai
#
# 反代网段（逗号分隔）。单机默认 172.29.0.0/24,127.0.0.1/32（compose 固定网段 + 回环）。
# 直连（没有反代）时留空最安全：留空 = 不信任何代理头。
# 配错（如 0.0.0.0/0 或 v4 < /16）会**拒绝启动** —— 那等于把来源 IP 交给请求头。
#
# 为什么默认里必须有 127.0.0.1/32：edge（宝塔/宿主 nginx）通常把请求转给 web 容器
# 发布的 127.0.0.1 端口，web nginx 再用 $proxy_add_x_forwarded_for 追加自己看到的
# $remote_addr（= docker-proxy 的 127.0.0.1）。后端从右往左取第一个"不可信"地址，
# 不信任回环时取到的就是 127.0.0.1 —— **所有公网用户塌成同一个 IP**。
# LD_TRUSTED_PROXIES=172.29.0.0/24,127.0.0.1/32
#
# compose 网段。改了它就必须同时改上面的 LD_TRUSTED_PROXIES。
# LD_SUBNET=172.29.0.0/24
#
# 浏览器跨域直连 API 时允许的来源；精确匹配，不支持通配（生产配 * 会拒绝启动）。
# LD_ALLOWED_ORIGINS=https://www.example.com
#
# 会话 Cookie 的 Secure 属性：prod 默认 1（只允许 HTTPS 携带）。
# 只有在本地用 http 调试时才临时设 0 —— 生产设 0 等于把会话暴露给明文链路。
# LD_COOKIE_SECURE=1

# ---------- 6. 数据与留存 ------------------------------------------------
# 演示数据（供应商/模型/渠道/绑定/套餐）：生产保持 0。
# 注意：不写时**代码默认是 1**，只有本编排把它覆盖成 0；直接跑二进制会写演示数据。
# LD_SEED_ENABLED=0
# 内置厂商预设（默认写入但全部停用）。
# LD_BUILTIN_PRESETS=1
# 任务保留天数（0 = 只报告不删）。
# LD_TASK_RETENTION_DAYS=0
# 调用报文留存：full=留脱敏正文（排障友好，默认），meta=只留结构摘要，off=不留。
# LD_CALL_IO=1
# LD_CALL_IO_BODY=full
# LD_CALL_IO_RETENTION_DAYS=7

# ---------- 7. 观测 ------------------------------------------------------
# Prometheus 抓取：两个必须同时配，否则 /metrics 路由不存在（404）。
# LD_METRICS_HTTP=1
# LD_METRICS_TOKEN=
# 磁盘水位告警（百分比 / 绝对剩余 GB）。
# LD_CAPACITY_WARN_PERCENT=85
# LD_CAPACITY_MIN_FREE_GB=5
# 日志级别：debug / info / warn / error。
# LOG_LEVEL=info
# 预检失败是否落 0 费调用记录（默认开；高风险时段的排障依据）。
# LD_CALL_PREFLIGHT_LOG=1
# 单条报文留存上限（KB）与是否额外留 SSE 原文。
# LD_CALL_IO_MAX_KB=256
# LD_CALL_IO_SSE=0

# ---------- 8. 首次启动 ------------------------------------------------
# 管理员口令；留空则随机生成并在启动日志里打印一次，且强制改密。
# LD_BOOTSTRAP_ADMIN_PASSWORD=

# ---------- 9. 出站与上游 ----------------------------------------------
# 自建内网上游（vLLM / Ollama / 内网 MinIO）才置 1；默认只允许公网。
# LD_UPSTREAM_ALLOW_PRIVATE=0

# ---------- 10. 后台任务与并发 ------------------------------------------
# Redis 不可用时是否禁止自认 leader（默认 1 = 禁止，即全部定时任务暂停）。
# 设 0 才会"降级单实例直接执行"——只在确认全网只有一个实例时使用。
# LD_LEADER_LOCK_STRICT=1
# 优雅退出时等待在途任务的上限（默认 30s，超过 5min 会被夹回）。
# LD_TASK_DRAIN=30s
# 数据库连接池（多节点预算：节点数 × 上限 + 10 < PG max_connections）。
# LD_DB_MAX_OPEN=100
# LD_DB_MAX_IDLE=20
#
# 事故时的"只关一个面"开关（默认全开；改这里比重启整站安全）：
# LD_TASKS_API=1
# LD_TASK_RECHECK=1
# LD_TASK_RECHECK_HOURS=24
# LD_TASK_RECHECK_MODE=
# 对象存储孤儿对账（不设即不跑；设了也默认 dry-run）
# LD_STORAGE_GC=
# usage_daily 回看天数
# LD_USAGE_ROLLUP_DAYS=3

# ---------- 11. 排障专用（生产默认全部注释）-----------------------------
# 长等待探针口令：排查代理超时链路时临时配，排查完清空（空 = 端点 404）。
# LD_DIAG_HOLD_TOKEN=
# 同步图片等待上限（秒）；必须小于最外层反代的读超时（默认 780，上限 900）。
# LD_DUOMI_SYNC_IMAGE_WAIT_SEC=780
# 传输层超时：HTTP 读（默认 120s，0 = 不设，注意同步图像依赖长连接）、
# 流式空闲（默认 120s）、结算落库（默认见代码）。
# LD_HTTP_READ_TIMEOUT=120s
# LD_STREAM_IDLE_TIMEOUT=120s
# LD_SETTLE_DB_TIMEOUT=10s
# 媒体代理上限：单文件 MB / 直链有效期小时。
# LD_MEDIA_MAX_MB=64
# LD_MEDIA_TTL_HOURS=24
